{
  "version": 8,
  "name": "Chile Offline Streets",
  "glyphs": "asset://lynx_maps/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "__PMTILES_URI__",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f7f5ee" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#a7d2e5" } },
    { "id": "waterways", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": { "line-color": "#a7d2e5", "line-width": 1.4 } },
    { "id": "buildings", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#e5dfd2", "fill-outline-color": "#cfc8bb" } },
    { "id": "roads-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "paint": { "line-color": "#d9d2c7", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 14, 4.5] } },
    { "id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.4, 14, 3.2] } },
    { "id": "major-roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", "class", "motorway", "trunk", "primary"], "paint": { "line-color": "#e9b779", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 14, 5] } },
    { "id": "road-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 11, "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#565650", "text-halo-color": "#ffffff", "text-halo-width": 1.3 } },
    { "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 12, 16] }, "paint": { "text-color": "#42413e", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } }
  ]
}
