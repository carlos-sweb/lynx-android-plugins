{
  "name": "lynx-android-plugins-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["examples/*", "packages/js"],
  "scripts": {
    "check": "bun run build:packages && bun --workspaces run check",
    "build:examples": "bun run build:packages && bun run --filter '@lynx-android-plugins/*' build",
    "build:packages": "bun run --filter lynx-android-plugins build",
    "check:packages": "bun run --filter lynx-android-plugins check",
    "check:maps-docs": "bun run build:packages && bun tools/sync-maps-docs.mjs && bun tools/check-maps-docs.mjs",
    "test:packages": "bun test packages/shared/bridge.test.ts packages/js/tests",
    "central:bundle": "./gradlew prepareCentralBundle",
    "central:upload": "node tools/central-upload.mjs",
    "central:status": "node tools/central-status.mjs"
  },
  "devDependencies": {
    "@lynx-js/config-rsbuild-plugin": "^0.2.0",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.0",
    "@lynx-js/rspeedy": "^0.17.0",
    "@lynx-js/template-webpack-plugin": "^0.16.0",
    "@lynx-js/type-element-api": "0.0.9",
    "@lynx-js/types": "4.1.0",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@types/mithril": "^2.2.9",
    "mithril-lynx": "2.5.0",
    "mithril-runtime": "^1.1.0",
    "typescript": "~5.9.0"
  },
  "engines": { "node": "^20.19.0 || >=22.12.0" }
}
