<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <!-- Only CameraPlugin uses this provider. Applications that don't
             register CameraPlugin do not need to declare it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.lynx_android_plugins.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/lynx_android_plugin_paths" />
        </provider>
    </application>
</manifest>
